# ============================================================
#  OPLS force field
# Dielectric constant via dipole fluctuations
# ============================================================

# ---------- INITIALIZATION ----------
units           real
boundary        p p p
atom_style      full

# ---------- FORCE FIELD (OPLS) ----------
pair_style      lj/cut/coul/long 12.0 12.0
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  cvff

pair_modify     mix geometric
special_bonds   lj/coul 0.0 0.0 0.5

kspace_style    pppm 1.0e-5

# ---------- READ SYSTEM ----------
read_restart    restart.nvt_final
include         system.in.settings


fix             NVT all nvt temp 298.0 298.0 100.0

# ============================================================
# PRODUCTION: DIELECTRIC CONSTANT
# ============================================================

# --- Molecular dipoles ---
thermo          1000
thermo_style    custom step temp etotal

timestep 1.0

compute unwrap all property/atom xu yu zu

variable mux atom q*c_unwrap[1]
variable muy atom q*c_unwrap[2]
variable muz atom q*c_unwrap[3]

compute cMx all reduce sum v_mux
compute cMy all reduce sum v_muy
compute cMz all reduce sum v_muz

variable Mx equal c_cMx
variable My equal c_cMy
variable Mz equal c_cMz

fix DACF all ave/correlate 1 50000 50000 v_Mx v_My v_Mz type auto file dipole_acf.dat ave running

thermo          1000
run             3000000   # 3 ns production run

write_data   pc100_acf.data
